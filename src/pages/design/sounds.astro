---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorksRow from '../../components/WorksRow.astro';
import { getSiteSettings } from '../../lib/microcms';
import type { Sound } from '../../lib/types';

const settings = await getSiteSettings();

const samples: Sound[] = [
  {
    id: 's1',
    title: 'グッドマンズ / 助川太郎 渋谷毅',
    year: 2023,
    url: 'https://music.amazon.co.jp/',
    description:
      '2006年に高円寺に移転してから毎月調律しています。当時のオーナーの方が音にこだわりがある方で、ピアニストの方々を呼んでレコーディングをされていました。Amazon musicで聴けます。',
    thumbnail: {
      url: '/images/about-slider/germany-grand-iron-plates.png',
      width: 640,
      height: 640,
    },
  },
  {
    id: 's2',
    title: '裏窓での渋谷さん',
    year: 2011,
    url: 'https://www.youtube.com/watch?v=example',
    description:
      '新宿ゴールデン街の「裏窓」では2010年からライブが始まりました。1970年製ヤマハU1のピアノを調律しています。https://www.youtube.com/watch?v=example',
    thumbnail: {
      url: '/images/about-slider/germany-upright-piano.png',
      width: 640,
      height: 640,
    },
  },
  {
    id: 's3',
    title: '月光 / 吉田達也 × 三柴理',
    year: 2022,
    url: '#',
    description:
      '高円寺・JIROKICHIでの調律は1996年から。ピアノとドラムの10番勝負として収録された一枚です。古いピアノであっても省略せず通して調律しています。',
    thumbnail: {
      url: '/images/about-slider/germany-soundboard-bracing.png',
      width: 640,
      height: 640,
    },
  },
];

const patterns = [
  {
    id: '01',
    name: 'ギャラリー対置',
    note: '参考案に近い構成。正方形サムネ左・説明文右。キャプションは画像直下に「タイトル（西暦年）」。',
  },
  {
    id: '02',
    name: '縦積みエントリ（採用）',
    note: '画像→キャプション＋年→説明文の縦積み。モバイルでも階層が崩れない。本番 WorksRow に反映済み。',
  },
  {
    id: '03',
    name: '年号柱',
    note: '左に大きな西暦を立て、右にジャケット・タイトル・説明文。年代のカタログ感。',
  },
  {
    id: '04',
    name: 'シート帯',
    note: '横長の紙面。左に正方形、中央にタイトルと年、右に説明文が流れる。',
  },
  {
    id: '05',
    name: '展覧会ラベル',
    note: '画像下に小さな展覧会風ラベル（タイトル／年）。説明文は右の本文欄。',
  },
  {
    id: '06',
    name: 'タイムライン',
    note: '左レールに西暦。縦の時系列として音源をたどる読み方。',
  },
  {
    id: '07',
    name: 'ジャケット主景',
    note: '大きな正方形を主にし、下段でタイトル＋年と説明文を積むカード列。',
  },
  {
    id: '08',
    name: 'リード先行',
    note: '説明文を先に読み、末尾にサムネ・タイトル・年の小さなフッター行。',
  },
  {
    id: '09',
    name: 'コンパクト行',
    note: 'サムネ｜タイトル（年）｜説明の一行要約。件数が多いときの一覧向き。',
  },
  {
    id: '10',
    name: '余白カタログ',
    note: '広い余白と細線。キャプションは小さく、説明文の可読性を優先。',
  },
] as const;

function yearLabel(year?: number) {
  return year != null ? `${year}年` : '';
}
---

<BaseLayout
  title="音源・動画カード検証"
  description="調律した音源・動画のユニット比較カタログ（year / description 対応・開発用）"
  settings={settings}
  currentPath="/design/sounds/"
  noindex={true}
>
  <div class="snd-lab site-shell">
    <header class="snd-lab__intro">
      <p class="snd-lab__eyebrow">Development</p>
      <h1 class="snd-lab__title">音源・動画ユニット検証</h1>
      <p class="snd-lab__lead">
        構成要素に西暦（year）と説明文（description）を加えた10パターンです。URLがある場合はヘッドホンアイコン付きの「聴く」リンクを必ず表示します（検索非公開）。
      </p>
      <p class="snd-lab__meta">
        <a href="/design/">デザインシステム</a>
        ／
        <a href="/design/fv/">FV検証</a>
        ／
        <a href="/design/about/">About検証</a>
        ／
        <a href="/design/buttons/">ボタン検証</a>
        ／
        <a href="/#works">トップ（現行）</a>
      </p>
      <nav class="snd-lab__toc" aria-label="パターン一覧">
        {
          patterns.map((pattern) => (
            <a href={`#pattern-${pattern.id}`}>{pattern.id}</a>
          ))
        }
      </nav>
    </header>

    <section class="snd-lab__current" aria-label="現行スタイル">
      <h2 class="snd-lab__section-title">現行（02 縦積みエントリを採用）</h2>
      <WorksRow sounds={samples} />
    </section>

    <div class="snd-lab__grid">
      {
        patterns.map((pattern) => (
          <article class="snd-lab__card" id={`pattern-${pattern.id}`}>
            <header class="snd-lab__card-head">
              <span class="snd-lab__num">{pattern.id}</span>
              <div>
                <h2 class="snd-lab__card-title">{pattern.name}</h2>
                <p class="snd-lab__card-note">{pattern.note}</p>
              </div>
            </header>

            <div
              class:list={['snd-stage', `snd-stage--${pattern.id}`]}
              aria-label={`パターン ${pattern.id}: ${pattern.name}`}
            >
              <div class="snd-list" role="list">
                {samples.map((sound, index) => (
                  <article
                    class:list={['snd-item', `snd-p${pattern.id}`]}
                    role="listitem"
                    data-index={String(index + 1).padStart(2, '0')}
                  >
                    <span class="snd-p__year" aria-hidden="true">
                      {sound.year}
                    </span>
                    <span class="snd-p__visual">
                      <span class="snd-p__media">
                        {sound.thumbnail ? (
                          <img
                            class="snd-p__thumb"
                            src={sound.thumbnail.url}
                            alt=""
                            width="320"
                            height="320"
                            loading="lazy"
                          />
                        ) : (
                          <span class="snd-p__thumb snd-p__thumb--empty" aria-hidden="true" />
                        )}
                      </span>
                      <span class="snd-p__caption">
                        <span class="snd-p__title">{sound.title}</span>
                        {sound.year != null && (
                          <span class="snd-p__year-inline">（{yearLabel(sound.year)}）</span>
                        )}
                      </span>
                    </span>
                    <span class="snd-p__copy">
                      <span class="snd-p__desc">{sound.description}</span>
                      {sound.url ? (
                        <a
                          class="snd-p__listen"
                          href={sound.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <svg
                            class="snd-p__listen-icon"
                            viewBox="0 0 24 24"
                            width="16"
                            height="16"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <path
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.6"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M4.5 13.5v-2a7.5 7.5 0 0 1 15 0v2"
                            />
                            <path
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.6"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M4.5 13.5v2.2a1.8 1.8 0 0 0 1.8 1.8h.7a1.8 1.8 0 0 0 1.8-1.8v-1.4a1.8 1.8 0 0 0-1.8-1.8h-2.5Zm15 0v2.2a1.8 1.8 0 0 1-1.8 1.8h-.7a1.8 1.8 0 0 1-1.8-1.8v-1.4a1.8 1.8 0 0 1 1.8-1.8h2.5Z"
                            />
                          </svg>
                          <span class="snd-p__listen-label">聴く</span>
                        </a>
                      ) : null}
                    </span>
                  </article>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .snd-lab {
    padding: 4.8rem 0 8rem;
  }

  .snd-lab__intro {
    margin-bottom: 4rem;
    max-width: 64rem;
  }

  .snd-lab__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 1.2rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .snd-lab__title {
    margin: 0 0 1.2rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 4vw, 3.6rem);
    letter-spacing: 0.04em;
    font-feature-settings: var(--font-feature-display);
  }

  .snd-lab__lead {
    margin: 0 0 1.6rem;
    font-size: 1.52rem;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .snd-lab__meta {
    margin: 0 0 2rem;
    font-size: 1.36rem;
  }

  .snd-lab__toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.64rem;
  }

  .snd-lab__toc a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.2rem;
    height: 3.2rem;
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--accent);
    font-size: 1.28rem;
  }

  .snd-lab__toc a:hover {
    border-color: var(--accent);
  }

  .snd-lab__current {
    margin-bottom: 4rem;
    padding: 2.4rem;
    border: 1px solid var(--line);
    background: var(--paper-deep);
  }

  .snd-lab__section-title {
    margin: 0 0 1.6rem;
    font-size: 1.68rem;
  }

  .snd-lab__grid {
    display: grid;
    gap: 2.4rem;
  }

  .snd-lab__card {
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .snd-lab__card-head {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    padding: 1.6rem 2rem;
    border-bottom: 1px solid var(--line);
  }

  .snd-lab__num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.2rem;
    height: 3.2rem;
    border: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.36rem;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .snd-lab__card-title {
    margin: 0 0 0.4rem;
    font-size: 1.84rem;
  }

  .snd-lab__card-note {
    margin: 0;
    font-size: 1.36rem;
    color: var(--ink-muted);
  }

  .snd-stage {
    padding: 2.8rem 2.4rem 3.2rem;
    background:
      radial-gradient(ellipse 70% 50% at 12% 0%, rgba(125, 87, 64, 0.05), transparent 55%),
      linear-gradient(180deg, var(--paper-deep) 0%, var(--paper) 100%);
  }

  .snd-list {
    display: grid;
    gap: 3.2rem;
    max-width: 72rem;
  }

  .snd-item {
    color: inherit;
    text-decoration: none;
  }

  .snd-p__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .snd-p__thumb--empty {
    background: rgba(44, 38, 34, 0.08);
  }

  .snd-p__title {
    font-family: var(--font-display);
    font-feature-settings: var(--font-feature-display);
    font-variant-east-asian: proportional-width;
  }

  .snd-p__desc {
    font-size: 1.36rem;
    line-height: 1.85;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .snd-p__year {
    display: none;
  }

  .snd-p__copy {
    display: grid;
    gap: 1.2rem;
    align-content: start;
    justify-items: start;
  }

  .snd-p__listen {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    width: fit-content;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-body);
    font-size: 1.28rem;
    letter-spacing: 0.14em;
    line-height: 1;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .snd-p__listen-icon {
    display: block;
    width: 1.28em;
    height: 1.28em;
    flex-shrink: 0;
  }

  .snd-p__listen:hover {
    color: var(--walnut);
  }

  /* ——— 01 ギャラリー対置 ——— */
  .snd-p01 {
    display: grid;
    grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr);
    column-gap: 2.8rem;
    align-items: start;
  }

  .snd-p01 .snd-p__visual {
    display: grid;
    gap: 1rem;
  }

  .snd-p01 .snd-p__media {
    aspect-ratio: 1;
    overflow: hidden;
    box-shadow: 0 0.8rem 2rem rgba(44, 38, 34, 0.1);
    transition: box-shadow 0.35s ease, transform 0.35s ease;
  }

  .snd-p01 .snd-p__thumb {
    transition: transform 0.5s ease;
  }

  .snd-p01 .snd-p__caption {
    font-size: 1.36rem;
    letter-spacing: 0.02em;
    line-height: 1.55;
  }

  .snd-p01 .snd-p__copy {
    padding-top: 0.2rem;
    max-width: 42rem;
  }

  .snd-p01:hover .snd-p__media {
    transform: translateY(-0.2rem);
    box-shadow: 0 1.2rem 2.8rem rgba(44, 38, 34, 0.14);
  }

  .snd-p01:hover .snd-p__thumb {
    transform: scale(1.03);
  }

  /* ——— 02 縦積みエントリ ——— */
  .snd-stage--02 .snd-list {
    max-width: 36rem;
    gap: 4rem;
  }

  .snd-p02 {
    display: grid;
    gap: 1.2rem;
  }

  .snd-p02 .snd-p__visual {
    display: grid;
    gap: 1.2rem;
  }

  .snd-p02 .snd-p__media {
    aspect-ratio: 1;
    overflow: hidden;
    background: #1c1816;
  }

  .snd-p02 .snd-p__thumb {
    transition: transform 0.45s ease;
  }

  .snd-p02 .snd-p__caption {
    font-size: 1.52rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .snd-p02 .snd-p__year-inline {
    color: var(--ink-muted);
  }

  .snd-p02 .snd-p__copy {
    gap: 1.2rem;
    border-top: 1px solid var(--line);
    padding-top: 1.2rem;
  }

  .snd-p02 .snd-p__desc {
    color: var(--ink-muted);
  }

  .snd-p02:hover .snd-p__thumb {
    transform: scale(1.04);
  }

  /* ——— 03 年号柱 ——— */
  .snd-p03 {
    display: grid;
    grid-template-columns: 7.2rem minmax(11rem, 14rem) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    padding-bottom: 2.4rem;
    border-bottom: 1px solid var(--line);
  }

  .snd-p03 .snd-p__year {
    display: block;
    font-family: var(--font-display);
    font-size: 2.8rem;
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--walnut);
    font-feature-settings: var(--font-feature-display);
    transition: color 0.25s ease;
  }

  .snd-p03 .snd-p__year-inline {
    display: none;
  }

  .snd-p03 .snd-p__visual {
    display: contents;
  }

  .snd-p03 .snd-p__media {
    aspect-ratio: 1;
    overflow: hidden;
  }

  .snd-p03 .snd-p__caption {
    display: block;
    margin-bottom: 1rem;
    font-size: 1.68rem;
    letter-spacing: 0.03em;
    line-height: 1.4;
  }

  .snd-p03 .snd-p__caption,
  .snd-p03 .snd-p__copy {
    grid-column: 3;
  }

  .snd-p03 .snd-p__desc {
    color: var(--ink-muted);
  }

  .snd-p03:hover .snd-p__year {
    color: var(--accent);
  }

  /* ——— 04 シート帯 ——— */
  .snd-stage--04 .snd-list {
    gap: 1.6rem;
  }

  .snd-p04 {
    display: grid;
    grid-template-columns: 12rem minmax(14rem, 20rem) minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    padding: 1.6rem;
    background: rgba(255, 255, 255, 0.72);
    border-block: 1px solid var(--line);
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .snd-p04 .snd-p__visual {
    display: contents;
  }

  .snd-p04 .snd-p__media {
    aspect-ratio: 1;
    overflow: hidden;
  }

  .snd-p04 .snd-p__thumb {
    transition: transform 0.45s ease;
  }

  .snd-p04 .snd-p__caption {
    display: grid;
    gap: 0.64rem;
  }

  .snd-p04 .snd-p__title {
    display: block;
    font-size: 1.76rem;
    letter-spacing: 0.03em;
    line-height: 1.4;
  }

  .snd-p04 .snd-p__year-inline {
    display: inline-block;
    width: fit-content;
    padding: 0.2rem 0.64rem;
    border: 1px solid var(--line);
    font-family: var(--font-body);
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }

  .snd-p04 .snd-p__copy {
    gap: 1rem;
  }

  .snd-p04 .snd-p__desc {
    font-size: 1.28rem;
    color: var(--ink-muted);
  }

  .snd-p04:hover {
    background: #fff;
    border-color: var(--accent);
  }

  .snd-p04:hover .snd-p__thumb {
    transform: scale(1.05);
  }

  /* ——— 05 展覧会ラベル ——— */
  .snd-p05 {
    display: grid;
    grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr);
    column-gap: 3.2rem;
    align-items: start;
  }

  .snd-p05 .snd-p__visual {
    display: grid;
    gap: 0;
  }

  .snd-p05 .snd-p__media {
    aspect-ratio: 1;
    overflow: hidden;
    background: rgba(44, 38, 34, 0.04);
  }

  .snd-p05 .snd-p__caption {
    margin-top: 1.2rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    background: #fff;
    font-size: 1.28rem;
    letter-spacing: 0.04em;
    line-height: 1.55;
  }

  .snd-p05 .snd-p__year-inline {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 1.2rem;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
  }

  .snd-p05 .snd-p__copy {
    padding-top: 0.4rem;
    max-width: 40rem;
  }

  .snd-p05 .snd-p__desc {
    color: var(--ink-muted);
  }

  .snd-p05:hover .snd-p__caption {
    border-color: var(--walnut);
  }

  /* ——— 06 タイムライン ——— */
  .snd-stage--06 .snd-list {
    gap: 0;
    padding-left: 1.2rem;
    border-left: 1px solid var(--line);
  }

  .snd-p06 {
    position: relative;
    display: grid;
    grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr);
    gap: 2.4rem;
    align-items: start;
    padding: 0 0 3.2rem 2.4rem;
  }

  .snd-p06::before {
    content: '';
    position: absolute;
    left: -0.45rem;
    top: 0.4rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--walnut);
    box-shadow: 0 0 0 0.4rem var(--paper);
  }

  .snd-p06 .snd-p__year {
    display: block;
    position: absolute;
    left: 2.4rem;
    top: 0;
    font-family: var(--font-display);
    font-size: 1.36rem;
    letter-spacing: 0.12em;
    color: var(--walnut);
  }

  .snd-p06 .snd-p__year-inline {
    display: none;
  }

  .snd-p06 .snd-p__visual {
    display: contents;
  }

  .snd-p06 .snd-p__media {
    margin-top: 2.8rem;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .snd-p06 .snd-p__caption {
    display: block;
    margin-top: 2.8rem;
    margin-bottom: 1rem;
    font-size: 1.68rem;
    letter-spacing: 0.03em;
    line-height: 1.4;
  }

  .snd-p06 .snd-p__caption,
  .snd-p06 .snd-p__copy {
    grid-column: 2;
  }

  .snd-p06 .snd-p__desc {
    color: var(--ink-muted);
  }

  .snd-p06:hover::before {
    background: var(--accent);
  }

  /* ——— 07 ジャケット主景 ——— */
  .snd-stage--07 .snd-list {
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: 2.4rem;
    max-width: none;
  }

  .snd-p07 {
    display: grid;
    gap: 1.4rem;
  }

  .snd-p07 .snd-p__visual {
    display: grid;
    gap: 1.2rem;
  }

  .snd-p07 .snd-p__media {
    aspect-ratio: 1;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(44, 38, 34, 0.1),
      0 1.2rem 2.8rem rgba(44, 38, 34, 0.12);
