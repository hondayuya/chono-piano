---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { applyGlossaryLinks } from '../../lib/glossary';
import {
  formatDate,
  getGlossary,
  getNewsDetail,
  getNewsList,
  getSiteSettings,
} from '../../lib/microcms';

export async function getStaticPaths() {
  const news = await getNewsList(100);
  return news.map((item) => ({
    params: { slug: item.id },
  }));
}

const { slug } = Astro.params;
const settings = await getSiteSettings();
const glossary = await getGlossary();
const article = slug ? await getNewsDetail(slug) : null;

if (!article) {
  return Astro.redirect('/news/');
}

const body = applyGlossaryLinks(article.content, glossary);
---

<BaseLayout
  title={article.title}
  description={article.title}
  settings={settings}
  currentPath={`/news/${article.id}/`}
  breadcrumbs={[
    { label: 'お知らせ', href: '/news/' },
    { label: article.title },
  ]}
>
  <article id="top" class="site-shell article-page">
    <p class="news-list__date">{formatDate(article.publishedAt ?? article.createdAt)}</p>
    <h1 class="section__title">{article.title}</h1>
    <div class="prose" set:html={body} />
    <p class="article-page__back">
      <a href="/news/">お知らせ一覧へ戻る</a>
    </p>
  </article>
</BaseLayout>
