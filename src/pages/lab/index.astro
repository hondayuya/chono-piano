---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLabArticles, getSiteSettings } from '../../lib/microcms';

const settings = await getSiteSettings();
const articles = await getLabArticles();

const bySeries = articles.reduce<Record<string, typeof articles>>((acc, item) => {
  const key = item.series || item.category || 'その他';
  acc[key] ??= [];
  acc[key].push(item);
  return acc;
}, {});
---

<BaseLayout
  title="Labo CHONO"
  description="技術インフォメーション — Labo CHONO"
  settings={settings}
  currentPath="/lab/"
>
  <div id="top" class="site-shell lab-index">
    <h1 class="section__title">Labo CHONO</h1>
    <p class="section__lead">技術インフォメーション</p>
  </div>

  <section class="section">
    <div class="site-shell">
      <div class="meta-grid">
        {
          Object.entries(bySeries).map(([series, items]) => (
            <div class="meta-block">
              <h3>{series}</h3>
              <ul class="lab-index__list">
                {items.map((item) => (
                  <li>
                    <a href={`/lab/${item.id}/`}>{item.title}</a>
                    {item.excerpt && <p class="lab-index__excerpt">{item.excerpt}</p>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
